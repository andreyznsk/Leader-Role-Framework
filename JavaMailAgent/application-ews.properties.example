spring.profiles.active=ews
mail.protocol=ews

# Required
mail.username=user@domain.ru
mail.password=
ews.url=https://outlook.domain.ru/EWS/Exchange.asmx

# Recommended for corporate Exchange on-prem
ews.auth-type=NTLM

# Optional
ews.autodiscover=false
ews.domain=
ews.version=Exchange2010_SP2
ews.timeout-seconds=30
mail.poll-interval-seconds=60
mail.fetch-limit=20
mail.test-connection.timeout-seconds=15
mail.test-connection.max-folders-to-scan=500
memory.service.url=http://localhost:8082
memory.service.enabled=true
agent.provider=agent
agent.command=claude --print
